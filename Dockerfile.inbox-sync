FROM rubylang/ruby:4.0.9

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV LAMBDA_TASK_ROOT=/var/task
WORKDIR ${LAMBDA_TASK_ROOT}

COPY Gemfile Gemfile.lock ./
RUN bundle config set without "development test" && bundle install

COPY lib/ ${LAMBDA_TASK_ROOT}/lib/
COPY lambda/inbox_sync.rb ${LAMBDA_TASK_ROOT}/lambda_function.rb
COPY lambda/matrix_notifier.rb ${LAMBDA_TASK_ROOT}/matrix_notifier.rb

ENV RUBYLIB=${LAMBDA_TASK_ROOT}/lib
ARG BUILD_CONTENT_HASH=unknown
ENV BUILD_CONTENT_HASH=${BUILD_CONTENT_HASH}

COPY --chmod=755 scripts/lambda-ruby-entrypoint.sh /usr/local/bin/lambda-ruby-entrypoint
ENTRYPOINT ["/usr/local/bin/lambda-ruby-entrypoint"]
CMD ["lambda_function.WeblogAuthoring::InboxSyncLambdaHandler.call"]
