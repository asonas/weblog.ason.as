module WeblogAuthoring
  class DraftStore
    def publication_dispatch: (String, String, String) -> Hash[String, untyped]
    def published_redirect: (String) -> String?
    def resolve_published_route: (String) -> Hash[String, untyped]
    class Error < StandardError
      attr_reader status: Integer
      def initialize: (String, ?Integer) -> void
    end
    def create: (String, Hash[String, untyped]) -> Hash[String, untyped]
    def append: (String, Hash[String, untyped]) -> Hash[String, untyped]
    def begin_upload: (String, Hash[String, untyped]) -> Hash[String, untyped]
    def upload_chunk: (String, String, String | Integer, Hash[String, untyped]) -> Hash[String, untyped]
    def commit_upload: (String, String, Hash[String, untyped]) -> Hash[String, untyped]
    def read: (String, Hash[String, untyped]) -> Hash[String, untyped]
    def checkpoint_job: (String) -> Hash[String, untyped]
    def publication_receipt: (String, String, String) -> Hash[String, untyped]?
    def accept_verified_publication: (String, Hash[String, untyped], Hash[String, untyped]) -> Hash[String, untyped]
    def publication_job: (String, String) -> Hash[String, untyped]
    def publication_stages: (String, String) -> Array[Hash[String, untyped]]
    def publication_snapshot: (String, String) -> Hash[String, untyped]
    def published_snapshot: (String) -> Hash[String, untyped]?
    def published_route: (String) -> Hash[String, untyped]?
    def compact: (String) { (Hash[String, untyped]) -> Hash[String, untyped] } -> Hash[String, untyped]?
    def cleanup_compacted: (String, ?now: Time) -> Integer
    def activate_verified_checkpoint: (String, Hash[String, untyped], expected_checkpoint: Integer) -> Hash[String, untyped]
  end
end
