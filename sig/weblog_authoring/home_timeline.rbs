module WeblogAuthoring
  type timeline_cursor = { key: String, id: String }
  class HomeTimeline
    PAGE_SIZE: Integer
    KEY_PATTERN: Regexp
    @database: _PageRepository
    def self.key: (PageDocument) -> String
    def initialize: (_PageRepository) -> void
    def window: (untyped) -> Hash[String, untyped]
    private
    def cursor: (PageDocument) -> timeline_cursor
    def encode: (PageDocument) -> String
    def decode: (untyped) -> timeline_cursor?
  end
end
