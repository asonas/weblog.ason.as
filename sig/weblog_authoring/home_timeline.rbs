module WeblogAuthoring
  type timeline_cursor = { key: String, id: String }
  class HomeTimeline
    PAGE_SIZE: Integer
    KEY_PATTERN: Regexp
    @database: _PageRepository | PublishedArticleReader
    def self.key: (ArticleDocument) -> String
    def initialize: (_PageRepository | PublishedArticleReader) -> void
    def window: (untyped) -> Hash[String, untyped]
    private
    def cursor: (ArticleDocument) -> timeline_cursor
    def encode: (ArticleDocument) -> String
    def decode: (untyped) -> timeline_cursor?
  end
end
