module WeblogAuthoring
  interface _DsqlPageRow
    def fetch: ("page_type") -> page_type
             | ("status") -> page_status
             | (String) -> String
    def []: (String) -> String?
  end

  class DsqlDatabase
    DATABASE_ROLE: String
    SCHEMA: String
    TOKYO_OFFSET: String
    INBOX_RETENTION_SECONDS: Integer
    ADOPTION_RETENTION_SECONDS: Integer
    INBOX_KINDS: Hash[String, Array[String]]
    INBOX_PAYLOAD_KEYS: Hash[Array[String], Array[String]]
    INBOX_PAYLOAD_TYPES: Hash[Array[String], Hash[String, singleton(String) | singleton(Integer)]]
    WEBMENTION_CLEANUP_QUERIES: Hash[String, Array[String]]

    include _PageRepository

    def initialize: (host: String, content_dir: String | Pathname, ?clock: ^() -> Time, ?pool: untyped, ?monotonic_clock: ^() -> Float) -> void
    def healthy?: () -> bool
    def close: () -> untyped
    def scrapbox_line_metadata: (String) -> Array[Hash[Symbol, untyped]]
    def create_mobile_pairing: (code_digest: untyped, expires_at: untyped) -> untyped
    def exchange_mobile_pairing: (code_digest: untyped, device_name: untyped, token_digest: untyped) -> untyped
    def revoke_mobile_device: (untyped) -> bool
    def active_mobile_devices: () -> Array[Hash[String, untyped]]
    def touch_mobile_device: (untyped) -> untyped
    def create_mobile_upload: (device_id: untyped, upload_id: untyped, s3_key: untyped, client_upload_id: untyped, content_type: untyped, size: untyped, sha256: untyped, captured_at: untyped, captured_at_source: untyped) -> untyped
    def find_mobile_upload: (upload_id: untyped, device_id: untyped) -> untyped
    def find_inbox_item_by_source: (source: untyped, kind: untyped, source_id: untyped) -> InboxItem?
    def complete_mobile_upload: (upload_id: untyped, device_id: untyped) -> untyped
    def cleanup_mobile_uploads: (?limit: Integer) -> untyped
    def upsert_inbox_item: (source: untyped, kind: untyped, source_id: untyped, occurred_at: untyped, payload: untyped) -> InboxItem?
    def start_inbox_sync_run: (run_id: untyped, trigger: untyped, started_at: untyped, sources: untyped) -> bool
    def queue_inbox_sync_run: (run_id: untyped, trigger: untyped, queued_at: untyped, sources: untyped) -> bool
    def inbox_sync_run: (run_id: untyped) -> untyped
    def inbox_source_sync_state: (source: String) -> untyped
    def apply_inbox_source_snapshot: (run_id: untyped, source: untyped, snapshot: untyped, completed_at: untyped) -> untyped
    def fail_inbox_source_sync: (run_id: untyped, source: untyped, error: untyped, completed_at: untyped) -> untyped
    def finish_inbox_sync_run: (run_id: untyped, status: untyped, completed_at: untyped) -> untyped
    def list_inbox_items: (?source: untyped, ?kind: untyped) -> Array[InboxItem]
    def list_inbox_item_usages: () -> Array[InboxItemUsage]
    def find_inbox_item: (String) -> InboxItem?
    def prepare_inbox_image_adoption: (item_id: untyped, inbox_key: untyped, public_key: untyped) -> untyped
    def consume_inbox_item: (String) -> untyped
    def list_pending_inbox_image_finalizations: (?limit: Integer) -> Array[InboxImageAdoption]
    def complete_inbox_image_adoption: (item_id: String) -> untyped
    def cleanup_inbox_items: (?limit: Integer) -> untyped
    def record_verified_webmention: (job: untyped, response: untyped, title: untyped, site_name: untyped, content_hash: untyped) -> untyped
    def record_webmention_deletion: (job: untyped, response: untyped, reason: String) -> untyped
    def record_webmention_failure: (job: untyped, result: String, message: String) -> untyped
    def list_webmentions: (?moderation_status: String?, ?verification_status: String?) -> Array[Hash[String, untyped]]
    def list_webmention_failures: () -> Array[Hash[String, untyped]]
    def webmention_reverification: (String) -> Hash[String, untyped]?
    def stale_approved_webmentions: (before: Time, limit: Integer) -> Array[Hash[String, untyped]]
    def webmention_outbox: (String) -> Hash[String, untyped]?
    def pending_webmention_outbox: (?limit: Integer) -> Array[Hash[String, untyped]]
    def pending_webmention_outbox_for_page: (String) -> Hash[String, untyped]?
    def request_publication_refresh: (String) -> Hash[String, untyped]?
    def compact_webmention_outbox: (?dry_run: bool) -> Hash[String, Integer]
    def webmention_page_targets: (String) -> Array[Hash[String, untyped]]
    def mark_webmention_outbox_notified: (String) -> untyped
    def complete_webmention_outbox: (String, ?revision: String?) -> bool
    def fail_webmention_outbox: (String) -> untyped
    def record_webmention_delivery: (job: untyped, status: String, ?http_status: Integer?, ?error: String?) -> untyped
    def list_webmention_delivery_failures: () -> Array[Hash[String, untyped]]
    def webmention_delivery_retry: (String) -> Hash[String, untyped]?
    def delete_webmention: (id: String) -> untyped
    def cleanup_expired_webmentions: (kind: String, limit: Integer, dry_run: bool) -> Hash[String, untyped]
    def approved_webmentions_for_page: (String) -> Array[Hash[String, untyped]]
    def moderate_webmention: (id: String, decision: String) -> Hash[String, untyped]?

    private

    def record_inbox_source_success: (untyped, run_id: untyped, source: untyped, snapshot: untyped, counts: untyped, completed_at: untyped) -> untyped
    def record_inbox_item_usage_with_connection: (untyped, untyped, untyped) -> untyped
    def consume_inbox_item_with_connection: (untyped, untyped, required: bool) -> untyped
    def validate_inbox_identity!: (untyped, untyped, untyped) -> untyped
    def inbox_item_from_row: (untyped) -> InboxItem
    def inbox_image_adoption_from_row: (untyped) -> InboxImageAdoption
    def mobile_upload_columns: () -> String
    def mobile_upload_from_row: (untyped) -> Hash[String, untyped]
    def new_document: (SaveRequest) -> PageDocument
    def updated_document: (PageDocument, SaveRequest) -> PageDocument
    def ensure_unique_route!: (untyped, PageDocument, PageDocument?) -> untyped
    def insert_page: (untyped, PageDocument) -> untyped
    def update_page: (untyped, PageDocument) -> untyped
    def replace_links: (untyped, PageDocument) -> untyped
    def replace_line_metadata_after_save: (untyped, PageDocument, PageDocument?, Array[Hash[Symbol, untyped]]) -> untyped
    def page_values: (PageDocument) -> Array[untyped]
    def page_from_row: (_DsqlPageRow, ?timings: Hash[String, Float]?) -> PageDocument
    def select_sql: (String) -> String
    def validate_expected_update: (PageDocument, SaveRequest) -> untyped
    def now: () -> Time
    def parse_time: (untyped) -> Time
    def with_connection: [A] (?timings: Hash[String, Float]?) { (untyped) -> A } -> A
    def monotonic_time: () -> Float
    def elapsed_ms: (Float) -> Float
    def record_timing: (Hash[String, Float]?, String, Float?) -> void
    def add_timing: (Hash[String, Float]?, String, Float) -> void
    def find_or_create_webmention_relation: (untyped, untyped, Time) -> Hash[String, untyped]
    def upsert_webmention_snapshot: (untyped, relation_id: String, source_url: String, title: untyped, site_name: untyped, content_hash: String, timestamp: Time) -> untyped
    def record_webmention_attempt: (untyped, job: untyped, relation_id: String?, result: String, timestamp: Time, ?response: untyped, ?content_hash: String?) -> untyped
    def approve_webmention: (untyped, String, Time) -> untyped
    def reject_webmention: (untyped, String, Time) -> untyped
    def reset_webmention_decision: (untyped, String, Time) -> untyped
    def webmention_from_dsql_row: (untyped) -> Hash[String, untyped]
    def webmention_snapshot: (String, untyped, untyped, untyped) -> Hash[String, untyped]?
    def public_webmention: (Hash[String, untyped]) -> Hash[String, untyped]
    def webmention_failure_from_dsql_row: (untyped) -> Hash[String, untyped]
    def enqueue_webmention_outbox: (untyped, PageDocument?, PageDocument) -> untyped
    def webmention_source_url: (String) -> String
    def webmention_outbox_from_dsql_row: (untyped) -> Hash[String, untyped]
  end
end
