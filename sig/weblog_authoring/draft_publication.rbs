module WeblogAuthoring
  class DraftAdministration
    def initialize: (store: DraftStore, publication: DraftPublication) -> void
    def list: (?query: String, ?cursor: String) -> Hash[String, untyped]
    def daily: (untyped) -> Hash[String, untyped]
  end
  class DraftPublication
    def prepare: (String) -> Hash[String, untyped]
    def accept: (String, Hash[String, untyped]) -> Hash[String, untyped]
  end

  class DraftPublisher
    def run: (String, String) -> Hash[String, untyped]
    def read: (Hash[String, untyped]) -> String
    def self.page: (Hash[String, untyped]?) -> PageDocument?
  end

  class DraftJobs
    def run: (String, String, ?retry_now: bool) -> Hash[String, untyped]
    def repair: () -> Hash[String, untyped]
  end

  class RemoteDraftJobs
    def run: (String, String, ?retry_now: bool) -> Hash[String, untyped]
    def repair: () -> Hash[String, untyped]
  end

  class DraftOutputs
    def feed: () -> String
    def search: (query: String, limit: Integer) -> untyped
  end
end
