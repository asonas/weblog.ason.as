{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "analyze": "fallow",
    "dev:bluesky-oauth": "tsx lambda/bluesky_oauth/development_server.ts",
    "format:authoring": "biome format --write frontend/authoring",
    "lint:authoring": "biome check --error-on-warnings frontend/authoring",
    "typecheck": "tsc --noEmit",
    "test:authoring": "tsx --test frontend/authoring/*.test.ts",
    "coverage:authoring": "c8 --all --include='frontend/authoring/**/*.{ts,tsx}' --exclude='frontend/authoring/*.test.ts' --exclude='frontend/authoring/*.d.ts' --reporter=text --reporter=lcov --reports-dir=coverage/frontend npm run test:authoring",
    "format:bluesky-oauth": "biome format --write lambda/bluesky_oauth",
    "lint:bluesky-oauth": "biome check --error-on-warnings lambda/bluesky_oauth",
    "typecheck:bluesky-oauth": "tsc --project tsconfig.bluesky-oauth.json --noEmit",
    "test:bluesky-oauth": "tsx --test lambda/bluesky_oauth/*.test.ts",
    "coverage:bluesky-oauth": "c8 --all --include='lambda/bluesky_oauth/**/*.ts' --exclude='lambda/bluesky_oauth/*.test.ts' --reporter=text --reporter=lcov --reports-dir=coverage/bluesky-oauth npm run test:bluesky-oauth",
    "build:bluesky-oauth": "tsc --project tsconfig.bluesky-oauth.json",
    "test:draft-worker": "tsx --test lambda/draft_worker/*.test.ts",
    "typecheck:draft-worker": "tsc --project tsconfig.draft-worker.json",
    "build:draft-worker": "tsc --project tsconfig.draft-worker-lambda.json",
    "lint:draft-worker": "biome check --error-on-warnings lambda/draft_worker",
    "format:scrapbox": "biome format --write scripts/scrapbox-to-weblog.ts scripts/scrapbox-to-weblog.test.ts",
    "lint:scrapbox": "biome check --error-on-warnings scripts/scrapbox-to-weblog.ts scripts/scrapbox-to-weblog.test.ts",
    "typecheck:scrapbox": "tsc --project tsconfig.scrapbox.json",
    "test:scrapbox": "tsx --test scripts/scrapbox-to-weblog.test.ts",
    "coverage:scrapbox": "c8 --all --include='scripts/scrapbox-to-weblog.ts' --reporter=text --reporter=lcov --reports-dir=coverage/scrapbox npm run test:scrapbox",
    "convert:scrapbox:all": "tsx scripts/scrapbox-to-weblog.ts",
    "convert:scrapbox:assets": "tsx scripts/scrapbox-to-weblog.ts --assets-only"
  },
  "dependencies": {
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/oauth-client-node": "^0.5.4",
    "@aws-sdk/client-ssm": "^3.1121.0",
    "@aws-sdk/dsql-signer": "^3.1121.0",
    "@jsquash/webp": "^1.5.0",
    "@progfay/scrapbox-parser": "10.1.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "d3-force": "^3.0.0",
    "highlight.js": "^11.11.2",
    "lowlight": "^3.3.0",
    "mediabunny": "1.55.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/aws-lambda": "^8.10.162",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "c8": "^12.0.0",
    "fallow": "^3.28.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "4.20.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
