{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "frontend/authoring/**/*.{ts,tsx,css}",
      "lambda/bluesky_oauth/**/*.ts",
      "lambda/draft_worker/**/*.ts",
      "scripts/scrapbox-to-weblog.ts",
      "scripts/scrapbox-to-weblog.test.ts",
      "scripts/repair-scrapbox-draft.ts",
      "scripts/integrate-worktree.mjs",
      "scripts/integrate-worktree.test.mjs",
      "scripts/dev-doctor.mjs",
      "scripts/dev-doctor.test.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
