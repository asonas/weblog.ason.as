#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "sqlite3"
require_relative "../lib/weblog_authoring/draft_migration"

command = ARGV.shift
options = {}
parser = OptionParser.new do |arguments|
  arguments.banner = "Usage: draft-migration export|check|rehearse --snapshot PATH [--database PATH] [--site-url URL]"
  arguments.on("--snapshot PATH", "Preserved JSON input (export never overwrites)") { |value| options[:snapshot] = value }
  arguments.on("--database PATH", "Source SQLite for export; isolated destination SQLite for rehearse") { |value| options[:database] = value }
  arguments.on("--site-url URL", "Original site origin, required for export") { |value| options[:site_url] = value }
end
parser.parse!
raise OptionParser::InvalidArgument, parser.banner unless %w[export check rehearse].include?(command) && ARGV.empty?
snapshot_path = options.fetch(:snapshot) { raise OptionParser::MissingArgument, "--snapshot" }

if command == "export"
  database = options.fetch(:database) { raise OptionParser::MissingArgument, "--database" }
  origin = options.fetch(:site_url) { raise OptionParser::MissingArgument, "--site-url" }
  source = WeblogAuthoring::DraftMigration.export_sqlite(database, site_url: origin)
  File.open(snapshot_path, "wx", 0o600) { |file| file.write(JSON.generate(source)) }
  puts JSON.generate("articles" => source.fetch("articles").length, "snapshot" => snapshot_path)
else
  source = JSON.parse(File.read(snapshot_path))
  plan = WeblogAuthoring::DraftMigration.new(store: nil).prepare(source)
  if command == "check"
    puts JSON.generate("articles" => plan.fetch("articles").length, "fingerprint" => plan.fetch("fingerprint"))
  else
    path = options.fetch(:database) { raise OptionParser::MissingArgument, "--database" }
    if File.exist?(path)
      existing = SQLite3::Database.new(path, readonly: true)
      begin
        owned = existing.get_first_value("PRAGMA application_id") == 0x57444d47
        raise "Destination is not a migration rehearsal database; refusing to modify it" unless owned
      ensure
        existing.close
      end
    else
      File.open(path, "wx", 0o600) { nil }
      created = SQLite3::Database.new(path)
      begin
        created.execute("PRAGMA application_id = 1464094023")
      ensure
        created.close
      end
    end
    store = WeblogAuthoring::DraftStore.sqlite(path)
    store.setup!
    puts JSON.generate(WeblogAuthoring::DraftMigration.new(store:).import(source))
  end
end
