#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "openssl"
require "json"
ENV["PGSSLROOTCERT"] ||= OpenSSL::X509::DEFAULT_CERT_FILE
require "aurora_dsql_pg"
require_relative "../lib/weblog_authoring/draft_migration"

command = ARGV.shift
options = {}
parser = OptionParser.new do |arguments|
  arguments.banner = "Usage: draft-cutover status|initialize|export|import|transition --host HOST [options]"
  %w[host confirm-host snapshot site-url fingerprint from to evidence].each do |key|
    arguments.on("--#{key} VALUE") { |value| options[key] = value }
  end
end
parser.parse!
raise OptionParser::InvalidArgument, parser.banner unless %w[status initialize export import transition].include?(command) && ARGV.empty?
host = options.fetch("host")
raise "Expected an explicit Aurora DSQL hostname" unless /\A[a-z0-9]+\.dsql\.[a-z0-9-]+\.on\.aws\z/.match?(host)
mutating = %w[initialize import transition].include?(command)
if mutating
  raise "Confirm the exact host before changing its draft tables" unless options["confirm-host"] == host
  evidence = JSON.parse(File.read(options.fetch("evidence")))
  raise "Preserve an approval/evidence record before mutation" unless evidence.is_a?(Hash) && evidence["record"].is_a?(String) && !evidence.fetch("record").strip.empty?
end
pool = AuroraDsql::Pg.create_pool(host:, user: "admin", application_name: "draft-cutover-operator", occ_max_retries: 3)
store = WeblogAuthoring::DraftStore.postgres(pool)
result = case command
         when "initialize"
           store.setup!
           store.setup_cutover!
           pool.with do |connection|
             tables = connection.exec("SELECT table_name FROM information_schema.tables WHERE table_schema = 'weblog_authoring' AND table_name LIKE 'draft_%'").map { |row| row.fetch("table_name") }
             tables.each do |table|
               raise "Unexpected draft table name" unless /\Adraft_[a-z_]+\z/.match?(table)
               connection.exec("GRANT SELECT, INSERT, UPDATE, DELETE ON weblog_authoring.#{table} TO weblog_authoring")
             end
           end
           store.cutover_status
         when "status"
           store.cutover_status
         when "transition"
           store.transition_cutover(expected: options.fetch("from"), to: options.fetch("to"), evidence:)
         when "export", "import"
           store.with_cutover_operation("migration") do
             state = store.cutover_status
             raise "Freeze and drain writers before export/import" unless state.fetch("phase") == "frozen" && state.fetch("operations").length == 1
             if command == "export"
               source = pool.with do |connection|
                 rows = connection.exec("SELECT id, page_type, name, page_date::text, title, status, body, cover_mode, cover_image_url, to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS created_at, to_char(updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS updated_at, to_char(published_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS published_at FROM weblog_authoring.pages ORDER BY id")
                 WeblogAuthoring::DraftMigration.export_rows(rows, site_url: options.fetch("site-url"))
               end
               File.open(options.fetch("snapshot"), "wx", 0o600) { |file| file.write(JSON.generate(source)) }
               plan = WeblogAuthoring::DraftMigration.new(store: nil).prepare(source)
               { "articles" => plan.fetch("articles").length, "fingerprint" => plan.fetch("fingerprint") }
             else
               source = JSON.parse(File.read(options.fetch("snapshot")))
               migration = WeblogAuthoring::DraftMigration.new(store:)
               raise "Migration fingerprint does not match the approved input" unless migration.prepare(source).fetch("fingerprint") == options.fetch("fingerprint")
               migration.import(source)
             end
           end
         end
puts JSON.generate(result)
