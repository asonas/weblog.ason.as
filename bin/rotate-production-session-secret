#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "securerandom"
require "aws-sdk-secretsmanager"

class ProductionSessionSecretRotation
  AWS_ACCOUNT_ID = "282782318939"
  SECRET_ID = "weblog-authoring-production/oauth"

  def initialize(client: Aws::SecretsManager::Client.new(region: "ap-northeast-1"))
    @client = client
  end

  def call
    secret_arn = @client.describe_secret(secret_id: SECRET_ID).arn
    account_id = secret_arn.split(":").fetch(4)
    raise "Expected AWS account #{AWS_ACCOUNT_ID}, got #{account_id}" unless account_id == AWS_ACCOUNT_ID

    current = JSON.parse(@client.get_secret_value(secret_id: SECRET_ID).secret_string)
    rotated = {
      github_client_id: current.fetch("github_client_id"),
      github_client_secret: current.fetch("github_client_secret"),
      session_secret: SecureRandom.hex(64),
    }
    @client.put_secret_value(secret_id: SECRET_ID, secret_string: JSON.generate(rotated))
  end
end

if $PROGRAM_NAME == __FILE__
  ProductionSessionSecretRotation.new.call
  puts "Rotated #{ProductionSessionSecretRotation::SECRET_ID} session secret"
end
