#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "uri"

class ProductionSmokeCheck
  ASSETS = {
    "/static/authoring/app.js" => "text/javascript",
    "/static/authoring/app.css" => "text/css",
  }.freeze

  def initialize(site_url, http: Net::HTTP)
    @site_url = URI(site_url)
    @http = http
  end

  def call
    html = fetch(@site_url)
    ASSETS.each do |path, content_type|
      raise "Production HTML does not reference #{path}" unless html.include?(%("#{path}"))

      fetch(URI.join(@site_url, path), expected_content_type: content_type)
    end
    JSON.parse(fetch(URI.join(@site_url, "/api/pages")))
  end

  private

  def fetch(uri, expected_content_type: nil)
    response = @http.get_response(uri)
    raise "#{uri} returned HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)
    if expected_content_type && !response["content-type"]&.start_with?(expected_content_type)
      raise "#{uri} returned Content-Type #{response['content-type'].inspect}"
    end

    response.body
  end
end

if $PROGRAM_NAME == __FILE__
  site_url = ARGV.fetch(0, "https://weblog.ason.as")
  ProductionSmokeCheck.new(site_url).call
  puts "Production HTML, referenced asset, and public pages API are reachable."
end
