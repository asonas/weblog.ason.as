#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/weblog_authoring/dsql_database"
require_relative "../lib/weblog_authoring/image_dimensions"

options = { apply: false }
OptionParser.new do |parser|
  parser.on("--host HOST") { |value| options[:host] = value }
  parser.on("--site-bucket BUCKET") { |value| options[:bucket] = value }
  parser.on("--apply") { options[:apply] = true }
end.parse!
host = options.fetch(:host) { raise OptionParser::MissingArgument, "--host" }
bucket = options.fetch(:bucket) { raise OptionParser::MissingArgument, "--site-bucket" }
pool = AuroraDsql::Pg.create_pool(host:, user: "admin", application_name: "image-dimensions-backfill")
database = WeblogAuthoring::DsqlDatabase.new(host:, content_dir: ".", pool:)
s3 = Aws::S3::Client.new(region: "ap-northeast-1")
urls = s3.list_objects_v2(bucket:, prefix: "assets/").flat_map do |response|
  response.contents.filter_map do |object|
    key = object.key
    next if key.start_with?("assets/previews/", "assets/inbox/thumbnails/")
    next unless key.match?(/\.(?:gif|jpe?g|png|webp)\z/i)

    "/#{key}" unless database.find_image_dimensions("/#{key}")
  end
end
puts JSON.pretty_generate(mode: options[:apply] ? "apply" : "dry-run", count: urls.length, images: urls)
if options[:apply]
  images = WeblogAuthoring::ImageDimensions.new(database:, s3_client: s3, bucket:)
  missing = urls.reject { |url| images.backfill(url) }
  puts JSON.pretty_generate(saved: urls.length - missing.length, unavailable: missing)
  exit(1) unless missing.empty?
end
