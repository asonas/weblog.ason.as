#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"

require_relative "../lib/weblog_authoring/dsql_database"

options = { apply: false }
OptionParser.new do |parser|
  parser.banner = "Usage: compact-webmention-outbox --host HOST [--apply]"
  parser.on("--host HOST", "Aurora DSQL host") { |value| options[:host] = value }
  parser.on("--apply", "Retain one pending publication refresh per page") { options[:apply] = true }
end.parse!

host = options.fetch(:host) { raise OptionParser::MissingArgument, "--host" }
pool = AuroraDsql::Pg.create_pool(
  host:, user: "admin", application_name: "webmention-outbox-compaction"
)
database = WeblogAuthoring::DsqlDatabase.new(host:, content_dir: ".", pool:)
summary = database.compact_webmention_outbox(dry_run: !options.fetch(:apply))
puts JSON.pretty_generate(summary.merge("mode" => options.fetch(:apply) ? "apply" : "dry-run"))
