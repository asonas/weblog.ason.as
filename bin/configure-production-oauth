#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "securerandom"
require "aws-sdk-ssm"
require "dotenv/load"

SECRET_ID = "/weblog-authoring-production/oauth"

client_id = ENV.fetch("GITHUB_CLIENT_ID")
client_secret = ENV.fetch("GITHUB_CLIENT_SECRET")
raise "GITHUB_CLIENT_ID is empty" if client_id.empty?
raise "GITHUB_CLIENT_SECRET is empty" if client_secret.empty?

client = Aws::SSM::Client.new(region: "ap-northeast-1")
session_secret = begin
  current = JSON.parse(client.get_parameter(name: SECRET_ID, with_decryption: true).parameter.value)
  current.fetch("session_secret") { SecureRandom.hex(64) }
rescue Aws::SSM::Errors::ParameterNotFound
  SecureRandom.hex(64)
end

client.put_parameter(
  name: SECRET_ID, type: "SecureString", tier: "Standard", overwrite: true,
  value: JSON.generate(
    github_client_id: client_id,
    github_client_secret: client_secret,
    session_secret:
  )
)

puts "Configured #{SECRET_ID}"
