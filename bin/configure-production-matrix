#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "aws-sdk-secretsmanager"
require "dotenv/load"

SECRET_ID = "weblog-authoring-production/inbox-matrix"

homeserver_url = ENV.fetch("MATRIX_HOMESERVER_URL")
room_id = ENV.fetch("MATRIX_ROOM_ID")
access_token = ENV.fetch("MATRIX_ACCESS_TOKEN")
raise "MATRIX_HOMESERVER_URL must use HTTPS" unless homeserver_url.start_with?("https://")
raise "MATRIX_ROOM_ID is empty" if room_id.empty?
raise "MATRIX_ACCESS_TOKEN is empty" if access_token.empty?

Aws::SecretsManager::Client.new(region: "ap-northeast-1").put_secret_value(
  secret_id: SECRET_ID,
  secret_string: JSON.generate(
    homeserver_url:,
    room_id:,
    access_token:
  )
)

puts "Configured #{SECRET_ID}"
